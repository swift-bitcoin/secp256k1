Globals:
# None of upstream's exported constants is ever NULL, so `N` drops the
# implicitly-unwrapped optional each would otherwise import as.
#
# secp256k1_context.shared must NEVER be destroyed, which is why
# Secp256k1Context does not wrap it -- that class's deinit owns destroy().
- Name: secp256k1_context_static
  SwiftName: "secp256k1_context.shared"
  Nullability: N
